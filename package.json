{
  "name": "image-prompt-gallery",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A minimal image and prompt gallery. Browse, search, and copy.",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3003 --strictPort",
    "build": "npm run check:content && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 3003 --strictPort",
    "check:content": "node scripts/check-content.mjs",
    "test": "node --test src/lib/search.test.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "lucide-react": "^1.16.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.1"
  }
}
